{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAssessmentSource",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::rhombus-assessment-source-20261017-hc666",
      "Condition": {
        "StringEquals": {
          "s3:prefix": "orders.csv"
        }
      }
    },
    {
      "Sid": "ReadWriteSingleAssessmentObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::rhombus-assessment-source-20261017-hc666/orders.csv"
    }
  ]
}
